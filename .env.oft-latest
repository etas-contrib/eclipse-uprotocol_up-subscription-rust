# shellcheck disable=SC2148,SC2034

# The file patterns that specify the relevant parts of the latest uProtocol Specification
# that this component is supposed to implement
UP_SPEC_FILE_PATTERNS="up-rust/up-spec/up-l3/usubscription/v4/README.adoc up-rust/up-spec/up-core-api/uprotocol/core/usubscription/v4/"

# The file patterns that specify the relevant parts of the latest up-rust uProtocol language library
# that contain relevant requirement definitions, implementations or tests.
UP_RUST_FILE_PATTERNS="up-rust/src/core/usubscription.rs up-rust/src/core/usubscription/"

# The file patterns that specify this component's resources which contain specification items
# that cover the requirements
COMPONENT_FILE_PATTERNS="*.md .github  up-subscription/src/"

OFT_FILE_PATTERNS="$UP_SPEC_FILE_PATTERNS $UP_RUST_FILE_PATTERNS $COMPONENT_FILE_PATTERNS"
OFT_TAGS="uSubscription"
